# 有填 NEXT_PUBLIC_AI_API_KEY，/ask 才會出現對話框。
# 這個金鑰會被打進瀏覽器的靜態檔，正式環境請改走你自己的代理，
# 把 NEXT_PUBLIC_AI_BASE_URL 指到代理，不要把真金鑰公開。
NEXT_PUBLIC_AI_API_KEY=
NEXT_PUBLIC_AI_BASE_URL=https://api.openai.com/v1
NEXT_PUBLIC_AI_MODEL=gpt-4o-mini

# 之後才用，現在程式沒有讀它們。見 lib/membership.ts
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
